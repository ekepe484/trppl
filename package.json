{
  "name": "trppl",
  "version": "1.0.0",
  "description": "Trppl — match on love language, compete in games, win the date.",
  "main": "backend/server.js",
  "scripts": {
    "start":       "node backend/server.js",
    "dev":         "nodemon backend/server.js",
    "build":       "cd trppl-react && npm run build",
    "build:watch": "cd trppl-react && npm run build -- --watch",
    "dev:full":    "concurrently \"npm run dev\" \"cd trppl-react && npm run dev\"",
    "setup-db":    "node scripts/setup-db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "twilio": "^5.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
