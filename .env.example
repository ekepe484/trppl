# Copy this to .env and fill in your values — never commit .env

# ── Database ─────────────────────────────────────────────────────────────────
# Docker local: docker run --name trppl-db -e POSTGRES_PASSWORD=secret -e POSTGRES_DB=trppl -p 5432:5432 -d postgres
DATABASE_URL=postgres://postgres:secret@localhost:5432/trppl

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (production) ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://trppl.onrender.com

# ── Auth ─────────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Nodemailer) ───────────────────────────────────────────────────────
# Leave blank in dev — Ethereal test account auto-created, preview URL in console
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Trppl <no-reply@trppl.app>

# ── Twilio (SMS OTP) ─────────────────────────────────────────────────────────
# Get free trial at twilio.com — leave blank to use dev mode (OTP printed to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEV_MODE=true

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520
