# Copy this to .env (same directory as docker-compose.yml)
# These values are read by docker-compose.yml

# ── Required ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_use_strong_password
JWT_SECRET=replace_with_64_char_random_string

# ── Anthropic (optional — leave blank to use mock face verification) ──────────
ANTHROPIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave blank in dev — Ethereal auto-created, OTP preview URL printed to logs
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Trppl <no-reply@trppl.app>

# ── Twilio SMS (optional) ─────────────────────────────────────────────────────
# Leave blank — OTPs printed to container logs in dev mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEV_MODE=true

# ── pgAdmin (if using --profile admin) ───────────────────────────────────────
PGADMIN_PASSWORD=admin
